APP_NAME=Laravel
APP_ENV=local
# EN PROD : APP_ENV=production + APP_DEBUG=false (jamais true en ligne !)
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# EN PROD (HTTPS) : passer à true pour des cookies de session sécurisés
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# EN PROD : smtp + vraies valeurs HOST/PORT/USERNAME/PASSWORD/ENCRYPTION (tls, 587)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Numéro WhatsApp pour le bouton "Acheter sur WhatsApp" des cartes produits.
# Format : chiffres uniquement, avec ou sans indicatif (ex: 22382019583 ou 82019583).
# Si 8 chiffres (Mali), l'indicatif 223 est ajouté automatiquement.
WHATSAPP_NUMBER=22382019583


# Connexion Google (Google Sign-In)
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI : login Google du site web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Client IDs OAuth autorisés pour la connexion Google de l'app mobile (audience de l'idToken).
# Plusieurs valeurs séparées par des virgules (web, android, ios). Voir README (section Connexion Google).
GOOGLE_ALLOWED_CLIENT_IDS=

# Cle de signature des URLs images redimensionnees (Glide)
GLIDE_KEY=

# SMS OTP telephone : log (dev, code dans les logs) puis passerelle reelle
SMS_DRIVER=log
# Passerelle Orange (https://developer.orange.com) : SMS_DRIVER=orange + ci-dessous
# SMS_ORANGE_CLIENT_ID=
# SMS_ORANGE_CLIENT_SECRET=
# SMS_ORANGE_SENDER=tel:+22370000000
# SMS_ORANGE_BASE_URL=https://api.orange.com

# OTP WhatsApp (verification des numeros) : log (dev/test, gratuit),
# gateway (ton propre numero via passerelle HTTP, 100% gratuit en auto-heberge)
# ou meta (API officielle)
WHATSAPP_OTP_DRIVER=log
# Option 100% gratuite : passerelle auto-hebergee du projet (dossier wa-gateway/ :
# npm install + npm start + scan QR avec ton numero). Meme machine en dev :
# WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001/send
# WHATSAPP_GATEWAY_FORMAT=json
# WHATSAPP_GATEWAY_TO=to
# WHATSAPP_GATEWAY_TEXT=body
# WHATSAPP_GATEWAY_TOKEN=le-meme-jeton-que-GATEWAY_TOKEN
# Passerelle sur TON numero WhatsApp (numero connecte en QR chez le fournisseur) :
# - Ultramsg (https://ultramsg.com) : cree une instance, scanne le QR avec ton numero
#   WHATSAPP_GATEWAY_URL=https://api.ultramsg.com/instanceXXXX/messages/chat
#   WHATSAPP_GATEWAY_FORMAT=form
#   WHATSAPP_GATEWAY_TO=to
#   WHATSAPP_GATEWAY_TEXT=body
#   WHATSAPP_GATEWAY_TOKEN=ton-token-ultramsg
#   WHATSAPP_GATEWAY_SUCCESS_KEY=sent
# - Green-API (https://green-api.com) : cree une instance, scanne le QR
#   WHATSAPP_GATEWAY_URL=https://api.green-api.com/waInstanceXXXX/sendMessage/ton-token
#   WHATSAPP_GATEWAY_FORMAT=json
#   WHATSAPP_GATEWAY_TO=chatId
#   WHATSAPP_GATEWAY_TEXT=message
#   WHATSAPP_GATEWAY_SUFFIX=@c.us
# WHATSAPP_GATEWAY_URL=
# WHATSAPP_GATEWAY_METHOD=POST
# WHATSAPP_GATEWAY_FORMAT=json
# WHATSAPP_GATEWAY_TO=to
# WHATSAPP_GATEWAY_TEXT=body
# WHATSAPP_GATEWAY_SUFFIX=
# WHATSAPP_GATEWAY_TOKEN=
# WHATSAPP_GATEWAY_SUCCESS_KEY=
# Meta WhatsApp Cloud API (https://developers.facebook.com) : WHATSAPP_OTP_DRIVER=meta + ci-dessous
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Template UTILITY approuve dans le dashboard Meta (FR) :
# << Boutique : votre code de verification est {{1}}. Il expire dans 10 minutes. >>
# WHATSAPP_OTP_TEMPLATE=otp_boutique
# WHATSAPP_OTP_LANG=fr
